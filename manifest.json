{
  "manifest_version": 3,
  "name": "InstaPlayer",
  "version": "1.1.0",
  "description": "Modern seek, playback speed, mute, fullscreen, and picture-in-picture controls for Instagram videos.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
